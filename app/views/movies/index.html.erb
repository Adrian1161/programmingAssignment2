<p style="color: green"><%= notice %></p>

<h1>Movies</h1>

<div id="movies">
    <table>
      <thead>
        <tr>
          <th><%= link_to "Title", movies_path(sort: "title", direction: "asc")%></th>
          <th><%= link_to "Rating", movies_path(sort: "rating", direction: "asc") %></th>
           <th><%= link_to "Release Date", movies_path(sort: "release_date", direction: "asc") %></th>
        </tr>
      </thead>   

      <tbody>
        <% @movies.each do |movie| %>
          <tr>
            <td>
              <%= link_to movie.title, movie %>
            </td>
            <td><%= movie.rating %></td>
            <td><%= movie.release_date %></td>
          </tr>
        <% end %>
      </tbody>

      <tfoot>
          <tr>
            <td colspan="3">Movie List</td>
          </tr>
      </tfoot>
    </table>
</div>
<%= link_to "New movie", new_movie_path %>
